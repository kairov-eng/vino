# Секреты не коммитить. Скопируйте в backend/.env и заполните.

DATABASE_URL=postgresql+psycopg2://postgresql:password@127.0.0.1:5432/vino
CORS_ORIGINS=http://127.0.0.1:8091,http://localhost:8091

# Локально после реорганизации: C:\dev\Vino2026\media\uploads
# (junction C:\dev\Vino2026\uploads → media\uploads тоже ок)
MEDIA_ROOT=C:\dev\Vino2026\media\uploads
MEDIA_URL_PATH=/media

SIGLIP2_ENDPOINT=https://vino-svoe.online/api_siglip2
DINOV3_ENDPOINT=https://vino-svoe.online/api_dinov3
EMBED_API_KEY=
EMBED_DIM=768
EMBED_TIMEOUT_SEC=120

HF_ENDPOINT=
HF_SIGLIP2_ENDPOINT=
HF_DINOV3_ENDPOINT=
HF_ACCESS_TOKEN=
HF_TIMEOUT_SEC=120
HF_START_TIMEOUT_SEC=15
HF_NAMESPACE=
HF_SIGLIP2_ENDPOINT_NAME=
HF_DINOV3_ENDPOINT_NAME=
HF_QWEN_OCR_ENDPOINT=
HF_QWEN_OCR_ENDPOINT_NAME=
HF_QWEN_OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
HF_QWEN_OCR_TIMEOUT_SEC=120

SIGLIP2_LOCAL_ENABLED=1
SIGLIP2_LOCAL_MODEL=google/siglip2-base-patch16-384
SIGLIP2_LOCAL_DIR=models/Siglip2
SIGLIP2_LOCAL_DEVICE=cpu
SIGLIP2_LOCAL_TORCH_THREADS=2

SEARCH_PHOTO_DIR=C:\dev\Vino2026\vino-svoe\backend\logs\photo
YOLO_MODEL_PATH=C:\dev\Vino2026\vino-svoe\backend\models\yolo\label_detect.pt
YOLO_BOTTLE_LABEL_MODEL_PATH=C:\dev\Vino2026\vino-svoe\backend\models\yolo_bottle_label\best.pt
XGB_MODEL_DIR=C:\dev\Vino2026\vino-svoe\backend\models\xgboost_text_matcher_abs_v14
YOLO_CONF=0.25
YOLO_IMGSZ=640
YOLO_DEVICE=0
YOLO_HALF=1

OCR_DET_MODEL_PATH=
OCR_REC_MODEL_PATH=
OCR_TIMEOUT_MS=700
OCR_BUDGET_SEC=180

GEMINI_PROXY_URL=https://vino-svoe.online
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_OCR_MAX_SIDE=1280
GEMINI_OCR_MAX_BYTES=3500000
GEMINI_OCR_TIMEOUT_SEC=100
GOOGLE_AI_API_VERTEX=0
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
# Path to real SA JSON (keep outside git; see service_account.example.json)
GOOGLE_APPLICATION_CREDENTIALS=
OPENAI_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_OCR_TIMEOUT_SEC=100

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_OCR_TIMEOUT_SEC=100

LABEL_OCR_PROMPT_PATH=app/pipeline/label_ocr_prompt.txt
OCR_PROMPT_PATH=app/pipeline/ocr_prompt.txt

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
