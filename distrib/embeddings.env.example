# Copy to distrib/embeddings.env on the server. NEVER commit real secrets.
# Used by: docker compose -f distrib/docker-compose.embeddings.yml --env-file distrib/embeddings.env

AIDNET_NAME=aidispatcher_aidnet

# Shared key (backend EMBED_API_KEY must match if set)
EMBED_API_KEY=

# Optional Redis cache (aidispatcher redis). Empty = no cache.
# REDIS_URL=redis://aidispatcher-redis:6379/0
REDIS_URL=
REDIS_CACHE_TTL=0

# --- SigLIP2 (container siglip2-embed, host 127.0.0.1:8090) ---
SIGLIP2_HOST_PORT=127.0.0.1:8090
SIGLIP2_DEVICE=cpu
SIGLIP_MODEL=google/siglip2-base-patch16-384
SIGLIP_API_KEY=
SIGLIP2_TORCH_THREADS=2
SIGLIP2_MEM_LIMIT=2600m
SIGLIP2_CPUS=4.0
SIGLIP2_HF_CACHE_HOST=/var/lib/vino-svoe/hf-cache/siglip2
OCR_WORKERS=4
OCR_THREADS=1

# --- DINOv3 (container dinov3-embed, host 127.0.0.1:8091) ---
# Port 8091 conflicts with local Vite; on prod frontend uses 8088 — OK.
DINOV3_HOST_PORT=127.0.0.1:8091
DINOV3_DEVICE=cpu
DINO_MODEL=facebook/dinov3-vitb16-pretrain-lvd1689m
DINO_API_KEY=
DINOV3_TORCH_THREADS=2
DINOV3_MEM_LIMIT=2400m
DINOV3_CPUS=2.0
DINOV3_HF_CACHE_HOST=/var/lib/vino-svoe/hf-cache/dinov3
# HF gated model download (if required)
HF_TOKEN=

# nginx (aidispatcher) must proxy:
#   https://vino-svoe.online/api_siglip2/ → http://siglip2-embed:8090/
#   https://vino-svoe.online/api_dinov3/  → http://dinov3-embed:8091/
# Backend .env:
#   SIGLIP2_ENDPOINT=https://vino-svoe.online/api_siglip2
#   DINOV3_ENDPOINT=https://vino-svoe.online/api_dinov3
#   EMBED_API_KEY=<same as above>
