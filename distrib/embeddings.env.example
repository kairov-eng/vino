# Copy to distrib/embeddings.env — NEVER commit real secrets.
# Prod today: keys live in /opt/siglip2/.env and /opt/dinov3/.env
# (same variable names). This file feeds distrib/docker-compose.embeddings.yml.

AIDNET_NAME=aidispatcher_aidnet

# Shared with backend EMBED_API_KEY
EMBED_API_KEY=

# Optional Redis (aidispatcher). Empty = no cache.
REDIS_URL=
REDIS_CACHE_TTL=0

# --- SigLIP2 (/opt/siglip2 → container siglip2-embed, 127.0.0.1:8090) ---
SIGLIP_MODEL=google/siglip2-base-patch16-384
SIGLIP_API_KEY=
OCR_WORKERS=4
OCR_THREADS=1

# --- DINOv3 (/opt/dinov3 → container dinov3-embed, 127.0.0.1:8091) ---
DINO_MODEL=facebook/dinov3-vitb16-pretrain-lvd1689m
DINO_API_KEY=
HF_TOKEN=

# nginx (aidispatcher):
#   /api_siglip2/ → siglip2-embed:8090
#   /api_dinov3/  → dinov3-embed:8091
