# Copy to distrib/.env on the server. NEVER commit real secrets.
# Keys mirror /opt/vino-svoe/distrib/.env on aidispatcher (vino-svoe.online).

# --- Postgres container vino_postgres (pgvector/pgvector:pg17) ---
VINO_PG_USER=vino
VINO_PG_PASSWORD=CHANGE_ME
VINO_PG_DB=vino
VINO_PGDATA_HOST=/var/lib/vino-svoe/postgres
# host bind for psql/restore from the server shell
VINO_PG_PORT=127.0.0.1:5433
# URL from vino_backend (Docker DNS name, port 5432 inside vino_net)
DATABASE_URL=postgresql+psycopg2://vino:CHANGE_ME@vino_postgres:5432/vino

CORS_ORIGINS=https://vino-svoe.online,https://www.vino-svoe.online
APP_ENV=prod

# Host paths mounted into containers
VINO_MEDIA_HOST=/var/lib/vino-svoe/media
VINO_MEDIA_THUMBS_HOST=/var/lib/vino-svoe/media_thumbs
VINO_SEARCH_PHOTOS_HOST=/var/lib/vino-svoe/search_photos
VINO_MODELS_HOST=/var/lib/vino-svoe/models
VINO_HF_CACHE_HOST=/var/lib/vino-svoe/hf-cache
VINO_SECRETS_HOST=/var/lib/vino-svoe/secrets
VINO_BACKEND_PORT=127.0.0.1:8092
# 8088 — не 8091: 8091 занят dinov3-embed
VINO_FRONTEND_PORT=127.0.0.1:8088
AIDNET_NAME=aidispatcher_aidnet

MEDIA_URL_PATH=/media

# Embeddings via public nginx (containers: /opt/siglip2, /opt/dinov3)
SIGLIP2_ENDPOINT=https://vino-svoe.online/api_siglip2
DINOV3_ENDPOINT=https://vino-svoe.online/api_dinov3
EMBED_API_KEY=CHANGE_ME
EMBED_DIM=768
EMBED_TIMEOUT_SEC=120

# Optional local SigLIP inside backend image (prod: off — use remote embed)
SIGLIP2_LOCAL_ENABLED=0
SIGLIP2_LOCAL_MODEL=google/siglip2-base-patch16-384
SIGLIP2_LOCAL_DEVICE=cpu
SIGLIP2_LOCAL_TORCH_THREADS=2

# HF Inference Endpoints (optional GPU path)
HF_ENDPOINT=
HF_SIGLIP2_ENDPOINT=
HF_DINOV3_ENDPOINT=
HF_ACCESS_TOKEN=
HF_TIMEOUT_SEC=120
HF_START_TIMEOUT_SEC=15
HF_NAMESPACE=
HF_SIGLIP2_ENDPOINT_NAME=
HF_DINOV3_ENDPOINT_NAME=
HF_QWEN_OCR_ENDPOINT=
HF_QWEN_OCR_ENDPOINT_NAME=
HF_QWEN_OCR_MODEL=Qwen/Qwen2.5-VL-3B-Instruct
HF_QWEN_OCR_TIMEOUT_SEC=120

YOLO_CONF=0.25
YOLO_IMGSZ=640
YOLO_DEVICE=cpu
YOLO_HALF=0

# Gemini через proxy на том же хосте (/opt/gemini-vision-proxy → :8093)
GEMINI_PROXY_URL=https://vino-svoe.online
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_OCR_MAX_SIDE=1280
GEMINI_OCR_MAX_BYTES=3500000
GEMINI_OCR_TIMEOUT_SEC=100

OPENAI_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_OCR_TIMEOUT_SEC=100

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_OCR_TIMEOUT_SEC=100

YANDEX_API_KEY=
YANDEX_FOLDER_ID=
YANDEX_OCR_URL=https://ocr.api.cloud.yandex.net/ocr/v1/recognizeText
YANDEX_OCR_MODEL=page
YANDEX_OCR_LANGUAGES=*
YANDEX_OCR_TIMEOUT_SEC=60

# Google Vision (эталон оценки: USE_GOOGLE_VISION_OCR=1)
USE_GOOGLE_VISION_OCR=1
GOOGLE_VISION_FEATURE=DOCUMENT_TEXT_DETECTION
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_AI_API_VERTEX=0

# Built-in OCR engines list (Rapid always available in image)
OCR_ENGINES=rapid
OCR_TIMEOUT_MS=700
OCR_BUDGET_SEC=180
OCR_HEAVY_ONLY_PREPROCESS_A=true
OCR_TIMEOUT_RAPID_SEC=60
OCR_TIMEOUT_EASY_SEC=60
OCR_TIMEOUT_TESS_SEC=60
OCR_TIMEOUT_SURYA_SEC=120
OCR_MAX_SIDE_EASY=512
OCR_MAX_SIDE_SURYA=448

# Site gate (optional)
password_admin=
# Optional non-admin password (only when password_admin is set).
password_user=

# Vertex SA JSON on host (never bake into image)
# GOOGLE_APPLICATION_CREDENTIALS=/var/lib/vino-svoe/secrets/service_account.json

