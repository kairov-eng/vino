# Copy to distrib/gemini-proxy.env — NEVER commit real secrets.
# Used by: docker compose -f distrib/docker-compose.gemini-proxy.yml --env-file distrib/gemini-proxy.env

AIDNET_NAME=aidispatcher_aidnet

# Google AI / Gemini API key (server stores the same in /opt/gemini-vision-proxy/.env)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_RPM=15
GEMINI_RPM_WINDOW_SEC=60
